{
  "name": "microduck-robot-soccer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-browser-runtime.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-browser-runtime.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "vite preview --host 127.0.0.1 --port 5173",
    "test": "node --test tests/*.test.mjs",
    "dev:native": "node server.mjs",
    "start:native": "node server.mjs --production"
  },
  "dependencies": {
    "@mujoco/mujoco": "3.11.0",
    "@xmldom/xmldom": "0.9.12",
    "onnxruntime-node": "1.30.0",
    "onnxruntime-web": "1.30.0",
    "three": "0.170.0",
    "vite": "6.4.4",
    "ws": "8.22.0"
  },
  "description": "MicroDuck robot soccer and dance simulator with MuJoCo physics and ONNX policies, running in the browser.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wander521/microduck-robot-soccer.git"
  },
  "homepage": "https://wander521.github.io/microduck-robot-soccer/",
  "keywords": [
    "microduck",
    "pollen-robotics",
    "robot-soccer",
    "robotics",
    "reinforcement-learning",
    "mujoco",
    "onnx",
    "threejs",
    "webassembly"
  ]
}
