  "dependencies": {
    "@mujoco/mujoco": "3.11.0",
    "@xmldom/xmldom": "0.9.12",
    "onnxruntime-node": "1.30.0",
    "onnxruntime-web": "1.30.0",
    "three": "0.170.0",
    "vite": "6.4.4",
    "ws": "8.22.0"
  }
}
