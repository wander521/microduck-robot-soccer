{
  "name": "microduck-football-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-browser-runtime.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-browser-runtime.mjs && vite build",
